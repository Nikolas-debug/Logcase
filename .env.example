# Copy to .env.local (local) or set as Railway variables. Never commit real values.
DATABASE_URL=postgres://postgres:PASSWORD@127.0.0.1:5432/loggo

# Cloudflare Images (dashboard → Images)
CF_ACCOUNT_ID=
CF_IMAGES_TOKEN=
NEXT_PUBLIC_CF_IMAGES_HASH=

# Better Auth: 32+ random chars; URL = public site address (https://your-domain in production)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Extra origins allowed to sign in, comma-separated (e.g. http://192.168.x.x:3100 for phone testing)
BETTER_AUTH_TRUSTED_ORIGINS=

# First staff account for npm run admin:create; remove the password once created
ADMIN_EMAIL=
ADMIN_PASSWORD=
